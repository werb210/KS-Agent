# KS-Agent - the Keystone AI assistant service. Single-brokerage settings below; the shared app is at the end.
# Set these as App Service settings in Azure (never commit real values).

# Required
SERVER_URL=https://server.example.com      # the licensee's KS-server (no trailing slash)
JWT_SECRET=                                # exactly the same value as the licensee's KS-server JWT_SECRET
OPENAI_API_KEY=
PORT=4000                                  # App Service sets this itself

# Optional
# AGENT_SERVICE_JWT_SECRET=                # signs the agent's service tokens instead of JWT_SECRET (KS-server must match)
# OPENAI_MODEL=gpt-4o-mini
# CORS_ALLOWED_ORIGINS=                    # comma-separated; default in production = the licensee's own apps from /api/licensee
# ASSISTANT_DAILY_TOKEN_BUDGET=20000000    # all sessions, per UTC day
# ASSISTANT_SESSION_DAILY_TOKEN_BUDGET=2000000
# ASSISTANT_PRIVATE_NUMBERS=               # comma-separated numbers the assistant must never say

# Fallbacks used only until GET {SERVER_URL}/api/licensee answers (it is loaded at startup and every 5 minutes)
# KS_COMPANY_NAME=
# KS_ASSISTANT_NAME=                       # default "Assistant"
# KS_SUPPORT_EMAIL=
# KS_SUPPORT_PHONE=
# CLIENT_URL=                              # where applications start, when the licensee has no client URL set

# KS_SHARED_HOSTING_v1 - the shared app (ks-shared-agent) only. Setting KS_CONTROL_DATABASE_URL switches on
# multi-brokerage mode: JWT_SECRET and the other per-brokerage values then come from each brokerage's ks_tenants row.
# KS_CONTROL_DATABASE_URL=postgres://ks_control_reader:...@ks-shared-pg.postgres.database.azure.com/ks_control?sslmode=require
# KS_TENANT_KEY=                           # decrypts ks_tenants.env_enc (same value as KS-Ops and KS-server)
# SERVER_URL=https://<the shared KS-server>
